{
  "name": "product.lookup_store_capability",
  "purpose": "Retrieve official Store/spoke/app version, compatibility, dependency and availability metadata.",
  "mode": "read",
  "risk_tier": "R0",
  "environments": [
    "personal_lab",
    "enterprise_when_approved"
  ],
  "inputs": {
    "name": "string",
    "release": "string optional"
  },
  "outputs": {
