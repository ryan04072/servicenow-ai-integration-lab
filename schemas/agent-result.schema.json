{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Result",
  "type": "object",
  "required": [
    "role",
    "status",
    "summary",
    "human_review_required"
  ],
  "properties": {
    "role": {
      "type": "string"
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "needs-human",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_required": {
      "type": "boolean"
    },
    "recommended_next_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommended_next_role": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
