{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextEnvelopeV2",
  "type": "object",
  "required": [
    "task_id",
    "task_type",
    "generated_at",
    "requirement",
    "sources",
    "artifacts",
    "relationships",
    "unresolved_questions"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirement": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "precedent": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "delivery_context": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_permissions": {
      "type": "object"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}