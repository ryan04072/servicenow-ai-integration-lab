{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Review",
  "type": "object",
  "required": [
    "service_now_role",
    "recommendation",
    "oob_assessment",
    "risks",
    "human_gate"
  ],
  "properties": {
    "service_now_role": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "oob_assessment": {
      "type": "string"
    },
    "existing_reuse": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adr_required": {
      "enum": [
        "yes",
        "no",
        "review"
      ]
    },
    "human_gate": {
      "type": "boolean"
    }
  }
}
