{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentEvalResult",
  "type": "object",
  "required": [
    "eval_id",
    "run_id",
    "dimension",
    "status",
    "score",
    "evidence"
  ],
  "properties": {
    "eval_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "dimension": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "warning",
        "not_run"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}