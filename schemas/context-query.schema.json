{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextQuery",
  "type": "object",
  "required": [
    "query",
    "limit"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "artifact_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "dependency_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  }
}