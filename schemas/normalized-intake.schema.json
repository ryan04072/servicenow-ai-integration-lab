{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedIntake",
  "type": "object",
  "required": [
    "requester",
    "persona",
    "problem",
    "desired_outcome",
    "success_criteria",
    "human_decisions"
  ],
  "properties": {
    "requester": {
      "type": "string"
    },
    "persona": {
      "type": "string",
      "enum": [
        "business",
        "it",
        "technical",
        "unknown"
      ]
    },
    "problem": {
      "type": "string"
    },
    "desired_outcome": {
      "type": "string"
    },
    "affected_users_or_process": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_or_data_concerns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roadmap_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft_acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}