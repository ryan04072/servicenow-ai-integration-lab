{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextEnvelope",
  "type": "object",
  "required": [
    "task_id",
    "task_type",
    "generated_at",
    "sources",
    "facts",
    "unresolved_questions"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "system",
          "id",
          "authority"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority": {
            "type": "string"
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "freshness": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_locator": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_permissions": {
      "type": "object"
    }
  }
}