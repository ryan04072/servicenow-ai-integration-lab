{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "TextBlock",
      "size": "Medium",
      "weight": "Bolder",
      "text": "ServiceNow architecture decision required"
    },
    {
      "type": "TextBlock",
      "wrap": true,
      "text": "${title}"
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Work item",
          "value": "${record_number}"
        },
        {
          "title": "Recommendation",
          "value": "${recommendation}"
        },
        {
          "title": "Risk",
          "value": "${risk}"
        },
        {
          "title": "Waiting since",
          "value": "${created_at}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "wrap": true,
      "text": "${summary}"
    },
    {
      "type": "Input.Text",
      "id": "comment",
      "isMultiline": true,
      "placeholder": "Optional decision comments / requested changes"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Approve",
      "data": {
        "action": "resolve_human_action",
        "action_id": "${action_id}",
        "decision": "approve"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Request Changes",
      "data": {
        "action": "resolve_human_action",
        "action_id": "${action_id}",
        "decision": "request_changes"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Reject",
      "data": {
        "action": "resolve_human_action",
        "action_id": "${action_id}",
        "decision": "reject"
      }
    },
    {
      "type": "Action.OpenUrl",
      "title": "Open Details",
      "url": "${source_url}"
    }
  ]
}